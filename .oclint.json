{
    "max-priority-1": 0,
    "max-priority-2": 5,
    "max-priority-3": 10,
    "enable-clang-static-analyzer": true,
    "report-type": "pmd",
    "threads": 4,
    "compilation-database": "%(compile_commands_dir)s",
    "exclude": [
        "ThirdParty",
        "submodules",
        "DerivedData",
        "Build",
        "build",
        "*.pbobjc.m",
        "*.generated.m",
        "*.h"
    ],
    "debug-selection": true,
    "debug-compilation-database": false,
    "no-recursive": false,
    "long-line": 200,
    "cyclomatic-count": 20,
    "not-inherited-method-count": 20,
    "not-overridden-method-count": 20,
    "method-count": 50,
    "class-depth": 5,
    "file-length": 2000,
    "method-length": 200,
    "parameter-count": 10,
    "ncss-method": 150,
    "npath": 200,
    "duplicate-line": 15
}
